{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_USE_MOCK_DATA",
        "NEXT_PUBLIC_USE_MOCK_AUTH",
        "NEXTAUTH_SECRET",
        "NEXTAUTH_URL",
        "GEMINI_API_KEY",
        "APP_URL",
        "API_URL",
        "GOOGLE_CLIENT_ID",
        "GOOGLE_CLIENT_SECRET"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
