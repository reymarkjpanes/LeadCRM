# Server-only API authority. Required at build/start and runtime.
# Local: localhost. Production: verified HTTPS backend, always ending /api/v1.
# Browsers continue to use same-origin /api/proxy. NEXT_PUBLIC_API_URL is unused.
API_URL=http://localhost:4000/api/v1
# Mocks are opt-in in development and always disabled in production.
NEXT_PUBLIC_USE_MOCK_AUTH=false
NEXT_PUBLIC_USE_MOCK_DATA=false
# Optional public Forms origin; omit to use the current browser origin.
NEXT_PUBLIC_FORM_ORIGIN=
# Next sets NODE_ENV for dev/build/start; do not force development in hosting.
# NODE_ENV=production
# Optional hosting port; next dev uses the package script's explicit port 3000.
# PORT=3000

# Retained legacy local keys for .env.local parity; not current runtime inputs.
# Keep credentials private. Do not add these legacy keys to hosting.
NEXT_PUBLIC_API_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
