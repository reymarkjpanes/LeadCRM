# Backend-only local test access. Configure the allowlist only in the development environment.
LEADCRM_TEST_AUTH_ENABLED=false
LEADCRM_TEST_EMAIL_ALLOWLIST=

# Separate production exception, disabled unless deliberately authorized.
LEADCRM_PRODUCTION_AUTH_ENABLED=false
LEADCRM_PRODUCTION_EMAIL_ALLOWLIST=

# Production background workers are disabled unless explicitly enabled after queue review.
# BACKGROUND_WORKERS_ENABLED=true
# With the other background workers disabled, opt in one Deal Updated workflow with one Move Deal Stage action.
# DEAL_STAGE_WORKFLOW_ID=
