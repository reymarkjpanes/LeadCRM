  id             String    @id @default(uuid())
  tenantId       String
  campaignId     String?
  leadId         String?
  contactId     String?
  fromEmail      String
  toEmail        String
  subject        String
  gmailMessageId String?   @unique
  gmailThreadId  String?
  status         String // sent|delivered|opened|clicked|bounced|failed
  sentAt         DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  campaign   Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead       Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact    Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  EmailEvent EmailEvent[]

  @@index([tenantId, leadId])
  @@index([tenantId, contactId])
  @@index([tenantId, campaignId])
  @@index([gmailMessageId])
  @@index([tenantId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// PASSWORD RESET TOKEN
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model PasswordResetToken {
  userId    String?
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��

// ═══════════════════════════════════════════════════════════════════════
// EMAIL VERIFICATION TOKEN (account security)
// Stores SHA-256 hash of the plaintext token. Single-use, time-limited.
// ═══════════════════════════════════════════════════════════════════════
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String?   // nullable — may be generated before user exists (e.g. pre-registration)
  email     String
  tokenHash String    @unique // SHA-256 hex digest of plaintext token
  type      String    @default("EMAIL_VERIFICATION")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
}

// EMAIL ACCOUNT (Gmail OAuth2 integration per user)
// Stores encrypted tokens for Gmail API access.
// Each user can connect ONE Gmail account per tenant.
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model EmailAccount {
  id             String    @id @default(uuid())
  tenantId       String
  userId         String
  provider       String    @default("gmail") // "gmail" | future: "outlook"
  email          String // the connected Gmail address
  accessToken    String // encrypted G�� never log or expose
  refreshToken   String? // encrypted G�� needed for offline access
  tokenExpiresAt DateTime?
  scopes         String[] // granted OAuth scopes
  isActive               Boolean  @default(true)
  lastSyncAt     DateTime?
  syncCursor     String? // Gmail history ID for incremental sync
  connectedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  syncLeaseUntil DateTime?
  syncLeaseId String?
  syncPageToken String?
  syncBaselineHistoryId String?
  syncError String?
  messages MailboxMessage[]

  @@unique([tenantId, userId, provider])
  @@index([tenantId, userId])
  @@index([tenantId, isActive])
}

// One-time OAuth challenges are bound to the initiating staff session.
model MailboxOAuthState {
  stateHash String @id
  tenantId String
  userId String
  sessionHash String
  verifier String
  expiresAt DateTime
  @@index([expiresAt])
}

model MailboxMessage {
  id String @id @default(uuid())
  tenantId String
  accountId String
  providerMessageId String
  threadId String
  direction String
  from String
  recipients String[]
  subject String
  body String @db.Text
  snippet String
  labels String[]
  sentAt DateTime
  rfcMessageId String?
  leadId String?
  contactId String?
  dealId String?
  meaningful Boolean @default(false)
  readyToClose Boolean @default(false)
  engagementRuleVersion Int @default(0)
  needsDealAssociation Boolean @default(false)
  createdAt DateTime @default(now())
  account EmailAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  @@unique([accountId, providerMessageId])
  @@index([tenantId, accountId, threadId, sentAt])
  @@index([tenantId, leadId, sentAt])
  @@index([tenantId, contactId, sentAt])
}

