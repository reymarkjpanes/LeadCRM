// LeadCRM - Prisma Schema
// Single source of truth for all database models
// ORM: Prisma 5 | DB: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// ENUMS
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��

enum TenantStatus {
  SANDBOX
  ACTIVE
  SUSPENDED
  CANCELLED
  DELETED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ContactStatus {
  HOT
  WARM
  COLD
  CANCELLED
  CLOSED
}

// System-owned lifecycle position G�� never manually editable via status controls.
// REQ131: ContactStatus (above) is human-owned and never changed by automation.
// This enum is the system-owned complement.
enum ContactLifecycleStage {
  LEAD // captured, not yet qualified
  QUALIFIED // qualified, ready for opportunity
  CONTACT // known person, active relationship
  CUSTOMER // has at least one won deal
  CHURNED // former customer, no active deals
  DISQUALIFIED // dead G�� will not proceed
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum CampaignType {
  EMAIL
  SMS
  MULTI_CHANNEL
}

enum CampaignStatus {
  SENDING
  INTERRUPTED
  SENT
  PARTIALLY_SENT
  DELIVERED
  FAILED
  DRAFT
}


// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// TENANT
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Tenant {
  dashboardRevision DashboardRevision?
  dealCreationReceipts DealCreationReceipt[]
  crmImportUploads CrmImportUpload[]
  productInterestRecords ProductInterest[]
  recordFiles        RecordFile[]
  id                 String             @id @default(uuid())
  name               String
  domain             String?
  slug               String             @unique
  industry           String?
  companySize        String? // "1-10" | "11-50" | "51-200" | "200+"
  website            String?
  currency           String?   @default("PHP") // ISO 4217 — e.g. "USD", "EUR", "GBP". Drives all money formatting UI-side.
  email              String?
  phone              String?
  address            String?
  status             TenantStatus       @default(SANDBOX)
  // -- Onboarding ----------------------------------------------------
  onboardingStep        Int       @default(0) // 0=introduction, 1=workflow, 2=company, 3=completed
  onboardingCompletedAt DateTime?
  ownerUserId        String?            // ID of the founding/registering user — set once at registration, immutable
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users              User[]
  userRoles          UserRole[]
  roleDefinitions    RoleDefinition[]
  sessions           Session[]
  organizations      Account[]
  leads              Lead[]
  contacts           Contact[]
  pipelines          Pipeline[]
  stages             Stage[]
  deals              Deal[]
  leadDeals          LeadDeal[]
  contactDeals       ContactDeal[]
  dealStageHistories DealStageHistory[]
  tasks              Task[]
  activities         Activity[]
  campaigns          Campaign[]
  campaignContacts   CampaignContact[]
  campaignMetrics    CampaignMetrics[]
  templates          Template[]
  targetAudiences    TargetAudience[]
  workflows          Workflow[]
  wfTriggerRecords   WorkflowTriggerRecord[]
  wfExecutionRuns    WorkflowExecutionRun[]
  wfExecutionSteps   WorkflowExecutionStep[]
  notifications      Notification[]
  notificationEvents NotificationEvent[]
  notificationDeliveries NotificationDelivery[]
  closingFieldDefinitions ClosingFieldDefinition[]
  auditLogs          AuditLog[]
  emailDeliveryLogs  EmailDeliveryLog[]
  EmailEvent         EmailEvent[]
  userPreferences    UserPreference[]
  tenantPreferences  TenantPreference[]
  crmImportJobs CrmImportJob[]
  tenantGroups       TenantGroup[]
  tenantGroupMembers TenantGroupMember[]
  marketingForms     MarketingForm[]
}

// Committed revision counters; no record payloads or second notification queue.
model DashboardRevision {
  tenantId String @id
  analytics BigInt @default(0)
  leads BigInt @default(0)
  actions BigInt @default(0)
  access BigInt @default(0)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// USER
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model User {
  crmImportUploads CrmImportUpload[]
  recordFiles        RecordFile[]
  id            String     @id @default(uuid())
  tenantId      String
  email         String
  firstName     String
  lastName      String
  mustChangePassword Boolean @default(true)
  passwordChangedAt DateTime?
  onboardingCompletedAt DateTime?
  passwordHash  String? // Legacy passwordless accounts use password recovery.
  phone         String?
  jobTitle      String?
  avatarUrl     String?
  lastLoginAt   DateTime?
  // Primary role identity for routing; custom permissions come from UserRole.
  // Assign explicitly and keep both representations in the same transaction.
  role          String
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  userRoles          UserRole[]
  sessions           Session[]
  organizationsOwned Account[]
  assignedLeads      Lead[]             @relation("AssignedLeads")
  createdLeads       Lead[]             @relation("CreatedLeads")
  updatedLeads       Lead[]             @relation("UpdatedLeads")
  convertedLeads     Lead[]             @relation("ConvertedLeads")
  assignedContacts  Contact[]          @relation("AssignedContacts")
  ownedContacts      Contact[]          @relation("OwnedContacts")

  assignedDeals        Deal[]             @relation("AssignedDeals")
  ownedDeals           Deal[]             @relation("OwnedDeals")
  revenueDeals         Deal[]             @relation("RevenueOwner")
  leadDealsAdded       LeadDeal[]
  contactDealsAdded   ContactDeal[]
  dealStageHistories   DealStageHistory[]
  assignedTasks        Task[]             @relation("AssignedTasks")
  tasksAssignedByMe    Task[]             @relation("TaskAssignedBy")
  completedTasks       Task[]             @relation("TaskCompletedBy")
  activitiesCreated    Activity[]
  notifications        Notification[]
  notificationDeliveries NotificationDelivery[]
  auditLogs            AuditLog[]
  userPreferences      UserPreference[]
  crmImportJobs CrmImportJob[]
  groupMemberships TenantGroupMember[]
  marketingForms   MarketingForm[]
  activatedWorkflows Workflow[] @relation("WorkflowActivator")

  @@unique([tenantId, email])
  @@index([tenantId, status])

  @@unique([id, tenantId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// ROLE DEFINITION
// permissions String[] removed G�� use RolePermission table instead
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model RoleDefinition {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  description  String?
  isSystemRole Boolean  @default(false)
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  userRoles   UserRole[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId, isArchived])

  @@unique([id, tenantId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// ROLE PERMISSION (per-module CRUD flags)
// One row per module per role.
// module examples: contacts | deals | campaigns | workflows | reports | users | settings
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model RolePermission {
  id        String  @id @default(uuid())
  tenantId  String
  roleId    String
  module    String // e.g. "contacts", "deals", "campaigns"
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)
  canArchive Boolean @default(false)
  canImport Boolean @default(false)
  canManageStages Boolean @default(false)
  canComplete Boolean @default(false)
  canAssign Boolean @default(false)
  canSend Boolean @default(false)
  canDuplicate Boolean @default(false)
  canViewReports Boolean @default(false)
  canActivate Boolean @default(false)
  canViewRuns Boolean @default(false)
  canPublish Boolean @default(false)
  canViewSubmissions Boolean @default(false)
  canViewClosedWon Boolean @default(false)
  canDisable Boolean @default(false)
  canRestore Boolean @default(false)

  role RoleDefinition @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@unique([roleId, module])
  @@index([roleId])
  @@index([tenantId, module])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// USER ROLE (JUNCTION)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model UserRole {
  id       String @id @default(uuid())
  userId   String
  roleId   String
  tenantId String

  user   User           @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  role   RoleDefinition @relation(fields: [roleId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant Tenant         @relation(fields: [tenantId], references: [id])

  @@unique([userId, roleId, tenantId])
  @@index([userId, tenantId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// SESSION (Token Revocation)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Session {
  id           String    @id @default(uuid())
  userId       String
  tenantId     String
  tokenHash    String    @unique // SHA-256 of JWT, never plaintext
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([userId, tenantId])
}

// ---------------------------------------------
// ---------------------------------------------

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// TENANT GROUP
// ─────────────────────────────────────────────────────────────
model TenantGroup {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  tenant  Tenant              @relation(fields: [tenantId], references: [id])
  members TenantGroupMember[]

  @@index([tenantId])

  @@unique([id, tenantId])
}

// TENANT GROUP MEMBER (junction: group ↔ user)
// ─────────────────────────────────────────────────────────────
model TenantGroupMember {
  id       String @id @default(uuid())
  groupId  String
  userId   String
  tenantId String

  group  TenantGroup @relation(fields: [groupId, tenantId], references: [id, tenantId], onDelete: Cascade)
  user   User        @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant Tenant      @relation(fields: [tenantId], references: [id])

  @@unique([groupId, userId])
  @@index([tenantId])
  @@index([groupId])
  @@index([userId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// ORGANIZATION
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Account {
  customFieldValues CustomFieldValue[]
  // False only for legacy rows requiring explicit product reconciliation.
  productsNormalized Boolean @default(false)
  productLinks AccountProductInterest[]
  productInterestOther String?
  id               String    @id @default(uuid())
  tenantId         String
  assignedUserId   String?
  name             String
  industry         String?
  size             String? // "1-10" | "11-50" | "51-200" | "200+"
  website          String?
  notes            String?   @db.Text
  internalNotes    String?   @db.Text
  tags             String[] @default([])
  productInterests String[] @default([])
  activeProducts   String[] @default([])
  address          String?
  city             String?
  province         String?
  country          String?   @default("Philippines")
  isArchived       Boolean   @default(false)
  deletedAt        DateTime?
  deletedBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  assignedUser User?      @relation(fields: [assignedUserId], references: [id])
  leads        Lead[]
  deals        Deal[]
  activities   Activity[]
  contacts     Contact[]
  recordFiles  RecordFile[]

  @@index([tenantId, isArchived])
  @@index([tenantId, name])
  @@index([tenantId, createdAt])
  @@index([tenantId, assignedUserId])
  @@index([tenantId])
  taskLinks TaskAccount[]

  @@unique([id, tenantId])

}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// CONTACT
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// LEAD
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Lead {
  customFieldValues CustomFieldValue[]
  // False only for legacy rows requiring explicit product reconciliation.
  productsNormalized Boolean @default(false)
  productLinks LeadProductInterest[]
  creationKey String?
  @@unique([tenantId, creationKey])
  formSubmissions FormSubmission[]
  id                  String    @id @default(uuid())
  tenantId            String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
  companyName         String?
  address             String?
  firstName           String
  lastName            String
  phone               String?
  email               String?
  productInterest     String[] @default([])
  productInterestIds  String[] @default([])
  source              String?
  assignedUserId      String?
  status              String    @default("Warm")
  accountId           String?
  createdById         String?
  updatedById         String?
  lastStatusChangedAt DateTime?
  lastCustomerReplyAt DateTime? @map("lastMeaningfulInboundAt")
  firstUnansweredOutboundAt DateTime?
  engagementEvaluatedAt DateTime?
  isArchived          Boolean   @default(false)
  deletedAt           DateTime?
  deletedBy           String?
  // Conversion tracking — set when lead is converted to a Contact
  contactId           String?
  convertedAt         DateTime?
  convertedById       String?
  @@index([tenantId, convertedAt, isArchived])

  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  account          Account? @relation(fields: [accountId], references: [id])
  assignedUser     User?    @relation("AssignedLeads", fields: [assignedUserId], references: [id])
  createdBy        User?    @relation("CreatedLeads", fields: [createdById], references: [id])
  updatedBy        User?    @relation("UpdatedLeads", fields: [updatedById], references: [id])
  convertedContact Contact? @relation("ConvertedFromLead", fields: [contactId], references: [id])
  convertedBy      User?    @relation("ConvertedLeads", fields: [convertedById], references: [id])

  leadDeals         LeadDeal[]
  activities        Activity[]
  campaignContacts  CampaignContact[]
  emailDeliveryLogs EmailDeliveryLog[]
  recordFiles       RecordFile[]

  @@index([tenantId, status])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, email])
  @@index([tenantId, createdAt])
  @@index([tenantId, accountId])
  @@index([tenantId, createdById])
  @@index([tenantId, contactId])
  @@index([tenantId])
  taskLinks TaskLead[]

  @@unique([id, tenantId])

}

// -----------------------------------------------------
// CONTACT
// ─────────────────────────────────────────────────────────────────────────────
// CONTRACT PHASE COMPLETE (ADR-001) — Organization model and Contact.organizationId removed.
// The canonical company link for Contact is now Contact.accountId → Account exclusively.
// Migration: remove_organization_model
// ─────────────────────────────────────────────────────────────────────────────

// -----------------------------------------------------
model Contact {
  customFieldValues CustomFieldValue[]
  // False only for legacy rows requiring explicit product reconciliation.
  productsNormalized Boolean @default(false)
  productLinks ContactProductInterest[]
  productInterestOther String?
  formSubmissions FormSubmission[]
  id                  String               @id @default(uuid())
  tenantId            String
  // Canonical company link (ADR-001) — Contact.accountId → Account
  accountId           String?
  assignedUserId      String?
  ownerId             String?
  firstName           String
  lastName            String
  email               String?
  phone               String?
  company             String?
  jobTitle            String?
  linkedinUrl         String?
  status              ContactStatus        @default(WARM)
  score               Int                  @default(75)
  source              String?
  notes               String?
  lastStatusChangedAt DateTime?
  lastCustomerReplyAt DateTime? @map("lastMeaningfulInboundAt")
  firstUnansweredOutboundAt DateTime?
  engagementEvaluatedAt DateTime?
  convertedAt         DateTime?
  doNotContact        Boolean              @default(false)
  isArchived          Boolean              @default(false)
  archiveReason       String?
  deletedAt           DateTime?
  deletedBy           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  activeProducts      String[]
  address             String?
  customerSince       DateTime?
  customerType        String               @default("Prospect")
  productInterests    String[]
  lifecycleStage      ContactLifecycleStage @default(LEAD)
  recordType          String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  account      Account?      @relation(fields: [accountId], references: [id])
  assignedUser User?         @relation("AssignedContacts", fields: [assignedUserId], references: [id])
  owner        User?         @relation("OwnedContacts", fields: [ownerId], references: [id])

  convertedFromLeads Lead[]             @relation("ConvertedFromLead")
  contactDeals       ContactDeal[]
  activities         Activity[]
  campaignContacts   CampaignContact[]
  emailDeliveryLogs  EmailDeliveryLog[]
  recordFiles        RecordFile[]

  @@index([tenantId, status])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, email])
  @@index([tenantId, createdAt])
  @@index([tenantId, accountId])
  @@map("Contact")
  @@index([tenantId])
  @@index([tenantId, isArchived])
  @@index([tenantId, lifecycleStage])
  taskLinks TaskContact[]

  @@unique([id, tenantId])

}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// PIPELINE & STAGE
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Pipeline {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  type        String? // e.g. "Sales" | "Service" | "Onboarding"
  templateKey String? // identifies seeded templates for upgrades (e.g. "sales-inquiries")
  isDefault   Boolean  @default(false)
  currency    String?  @default("PHP")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  stages Stage[]
  deals  Deal[]

  @@index([tenantId, isArchived])
  @@index([tenantId])

  @@unique([id, tenantId])
}

model Stage {
  id              String   @id @default(uuid())
  pipelineId      String
  tenantId        String // defence-in-depth: derived from Pipeline.tenantId at creation, never independently editable
  name            String
  order           Int
  probability     Int? // 0-100 for revenue forecasting
  color           String? // hex e.g. "#3fb950"
  description     String?
  isWon           Boolean  @default(false) // terminal: deal won
  isLost          Boolean  @default(false) // terminal: deal lost
  isDefault       Boolean  @default(false) // starting stage for new deals
  requiredFields  String[] // Deal fields required before entry (REQ089) e.g. ["accountId", "value"]
  rottenAfterDays Int? // days after which a deal in this stage is flagged stale
  createdAt       DateTime @default(now())

  pipeline               Pipeline           @relation(fields: [pipelineId, tenantId], references: [id, tenantId])
  tenant                 Tenant             @relation(fields: [tenantId], references: [id])
  deals                  Deal[]
  dealStageHistoriesNew  DealStageHistory[] @relation("NewStage")
  dealStageHistoriesPrev DealStageHistory[] @relation("PreviousStage")

  @@index([pipelineId, order])
  @@index([tenantId, pipelineId])
  @@index([tenantId])

  @@unique([id, pipelineId, tenantId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// DEAL
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Deal {
  customFieldValues CustomFieldValue[]
  productsNormalized Boolean @default(false)
  productInterestOther String?
  hasEverBeenWon Boolean @default(false)
  wonHistoryVerified Boolean @default(true)
  productInterestIds String[] @default([])
  recordFiles RecordFile[]
  productInterestId String?
  productInterestRecord ProductInterest? @relation(fields: [productInterestId, tenantId], references: [id, tenantId], onDelete: Restrict)
  automationKey String?
  @@unique([tenantId, automationKey])
  id                String    @id @default(uuid())
  tenantId          String
  pipelineId        String
  stageId           String
  accountId         String?
  assignedUserId    String?
  ownerId           String? // original deal owner (immutable)
  revenueOwnerId String? // agent captured at first won closure; legacy unknown stays null
  revenueOwnerEligible Boolean? // sales eligibility captured at closure, including later deactivation
  title             String
  value             Float?
  currency          String?   @default("PHP")
  priority          Priority  @default(MEDIUM)
  expectedCloseDate DateTime?
  closedAt          DateTime? // stamped when stage.isWon or stage.isLost = true
  wonConfirmationType String?
  wonConfirmationNote String?
  wonConfirmedById String?
  wonConfirmedAt DateTime?
  closingValues Json @default("{}")
  closingSnapshot Json?
  stageChangedAt DateTime?
  lostReason        String?
  leadSource        String?
  industry          String?
  productInterests  String[]
  address           String?
  tags              String[] // normalized to array G�� consistent with Contact.tags and Organization.tags
  order             Int       @default(0)
  isArchived        Boolean   @default(false)
  archiveReason     String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  pipeline       Pipeline           @relation(fields: [pipelineId, tenantId], references: [id, tenantId])
  stage          Stage              @relation(fields: [stageId, pipelineId, tenantId], references: [id, pipelineId, tenantId])
  organization   Account?           @relation(fields: [accountId], references: [id])
  assignedUser   User?              @relation("AssignedDeals", fields: [assignedUserId], references: [id])
  owner          User?              @relation("OwnedDeals", fields: [ownerId], references: [id])
  revenueOwner User? @relation("RevenueOwner", fields: [revenueOwnerId, tenantId], references: [id, tenantId], onDelete: Restrict)
  leadDeals      LeadDeal[]
  contactDeals   ContactDeal[]
  stageHistories DealStageHistory[]
  activities     Activity[]

  @@index([tenantId, stageId])
  @@index([tenantId, pipelineId])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, createdAt])
  @@index([tenantId, isArchived])
  @@index([tenantId])
  taskLinks TaskDeal[]

  @@unique([id, tenantId])

  mailboxThreads MailboxThreadAssociation[]
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// CONTACT-DEAL JUNCTION (multi-contact deals)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model LeadDeal {
  id        String   @id @default(uuid())
  leadId    String
  dealId    String
  tenantId  String
  role      String?
  addedById String?
  addedAt   DateTime @default(now())

  lead    Lead   @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)
  deal    Deal   @relation(fields: [dealId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant  Tenant @relation(fields: [tenantId], references: [id])
  addedBy User?  @relation(fields: [addedById], references: [id])

  @@unique([leadId, dealId])
  @@index([dealId, tenantId])
  @@index([leadId, tenantId])
  @@index([tenantId])
  position Int @default(0)
}

model ContactDeal {
  id        String   @id @default(uuid())
  contactId String
  dealId    String
  tenantId  String
  role      String?
  addedById String?
  addedAt   DateTime @default(now())

  contact Contact @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Cascade)
  deal    Deal    @relation(fields: [dealId, tenantId], references: [id, tenantId], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  addedBy User?   @relation(fields: [addedById], references: [id])

  @@unique([contactId, dealId])
  @@index([dealId, tenantId])
  @@index([contactId, tenantId])
  @@map("ContactDeal")
  @@index([tenantId])
  position Int @default(0)
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// DEAL STAGE HISTORY
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model DealStageHistory {
  id              String   @id @default(uuid())
  tenantId        String
  dealId          String
  previousStageId String?
  newStageId      String
  movedById       String
  movedAt         DateTime @default(now())
  timeInPrevStage Int? // minutes spent in previous stage (computed on insert)
  note            String?

  tenant        Tenant @relation(fields: [tenantId], references: [id])
  deal          Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  movedBy       User   @relation(fields: [movedById], references: [id])
  newStage      Stage  @relation("NewStage", fields: [newStageId], references: [id])
  previousStage Stage? @relation("PreviousStage", fields: [previousStageId], references: [id])

  @@index([dealId, tenantId])
  @@index([tenantId, movedAt])
  @@index([tenantId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// DEAL ACTION (manual actions performed on a deal)
// Mentor requirement: update_field, assign_agent, change_status, send_email, send_sms, etc.
// Distinct from automated WorkflowExecutionStep G�� these are user-initiated deal operations.
// Every DealAction also triggers an Activity entry for the timeline.
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// TASK
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Task {
  notificationVersion Int @default(0)
  id             String    @id @default(uuid())
  tenantId       String
  assignedUserId String
  assignedById   String?
  completedById  String?
  title          String
  description    String?
  status         String    @default("pending") // pending|in_progress|blocked|completed|cancelled
  priority       String    @default("Medium") // Low|Medium|High
  dueDate        DateTime
  reminderAt     DateTime?
  completedAt    DateTime?
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  assignedUser User       @relation("AssignedTasks", fields: [assignedUserId], references: [id])
  assignedBy   User?      @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  completedBy  User?      @relation("TaskCompletedBy", fields: [completedById], references: [id])
  activities   Activity[]

  @@index([tenantId, assignedUserId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId])
  leadLinks TaskLead[]
  contactLinks TaskContact[]
  dealLinks TaskDeal[]
  accountLinks TaskAccount[]

  @@unique([id, tenantId])

}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// ACTIVITY (unified timeline G�� typed FKs, no polymorphic)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Activity {
  id          String   @id @default(uuid())
  tenantId    String
  createdById String
  type        String // call|meeting|email|sms|note|task|workflow|stage_change|deal_action|file_upload
  title       String
  description String?
  metadata    Json?
  // Events may carry multiple contextual links; each supplied target must be valid.
  leadId      String?
  contactId  String?
  dealId      String?
  accountId   String?
  taskId      String?
  createdAt   DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  createdBy    User     @relation(fields: [createdById], references: [id])
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact      Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal         Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organization Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, createdAt])
  @@index([tenantId, contactId, createdAt])
  @@index([tenantId, dealId, createdAt])
  @@index([tenantId, createdAt])
  @@index([tenantId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// NOTIFICATION
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Notification {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  type       String // deal_assigned|task_due|campaign_sent|workflow_failed|deal_action|...
  title      String
  body       String?
  entityType String?
  entityId   String?
  eventKey   String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)

  occurredAt DateTime?

  @@index([userId, tenantId, isRead])
  @@index([tenantId, createdAt])
  @@index([tenantId])
  @@unique([tenantId, userId, eventKey])
  @@index([tenantId, userId, createdAt, id])
  @@index([tenantId, userId, isRead, createdAt, id])
}

// Transactional outbox. Triggers capture minimal structured business facts,
// never provider credentials, message bodies, or user-supplied destinations.
model NotificationEvent {
  id String @id @default(uuid())
  tenantId String
  eventKey String
  type String
  entityType String
  entityId String
  ownerId String?
  actorId String?
  admins Boolean @default(false)
  payload Json @default("{}")
  occurredAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
  createdAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
  availableAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
  attempts Int @default(0)
  leaseToken String?
  leaseUntil DateTime?
  processedAt DateTime?
  lastError String?
  tenant Tenant @relation(fields: [tenantId], references: [id])
  @@unique([tenantId, eventKey])
  @@index([tenantId, processedAt, availableAt, id])
  @@index([processedAt, availableAt, tenantId])
}

// Independent of visible notifications; deleting one never deletes its identity.
model NotificationDelivery {
  tenantId String
  userId String
  eventKey String
  outcome String @default("delivered")
  createdAt DateTime @default(dbgenerated("(CURRENT_TIMESTAMP AT TIME ZONE 'UTC'::text)"))
  tenant Tenant @relation(fields: [tenantId], references: [id])
  user User @relation(fields: [userId, tenantId], references: [id, tenantId], onDelete: Cascade)
  @@id([tenantId, userId, eventKey])
}

model ClosingFieldDefinition {
  values CustomFieldValue[]
  tenantId   String
  id         String
  definition Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt
  tenant     Tenant @relation(fields: [tenantId], references: [id])

  @@id([tenantId, id])
}

// Evolved ClosingFieldDefinition owns both normal CRM values and closing evidence.
// SQL enforces exactly one module-matching record reference; all FKs include tenant.
model CustomFieldValue {
  id String @id @default(uuid())
  tenantId String
  fieldId String
  module String
  leadId String?
  contactId String?
  accountId String?
  dealId String?
  value Json
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  field ClosingFieldDefinition @relation(fields: [tenantId, fieldId], references: [tenantId, id], onDelete: Restrict, map: "CustomFieldValue_field_fkey")
  lead Lead? @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "CustomFieldValue_lead_fkey")
  contact Contact? @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "CustomFieldValue_contact_fkey")
  account Account? @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "CustomFieldValue_account_fkey")
  deal Deal? @relation(fields: [dealId, tenantId], references: [id, tenantId], onDelete: Restrict, map: "CustomFieldValue_deal_fkey")
  @@unique([tenantId, fieldId, leadId])
  @@unique([tenantId, fieldId, contactId])
  @@unique([tenantId, fieldId, accountId])
  @@unique([tenantId, fieldId, dealId])
  @@index([tenantId, module, leadId, contactId, accountId, dealId], map: "CustomFieldValue_tenantId_module_leadId_contactId_accountId_de_")
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// TARGET AUDIENCE (campaign segmentation G�� no audience_contacts table)
// Contacts are resolved at query time using TargetAudienceCondition filters.
// mentor: "no need for audience_contacts, just filtration logic, query from contacts"
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model TargetAudience {
  source String @default("CONTACTS")
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isActive               Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant                    @relation(fields: [tenantId], references: [id])
  conditions TargetAudienceCondition[]
  campaigns  Campaign[]

  @@index([tenantId, isActive])
  @@index([tenantId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// TARGET AUDIENCE CONDITION (filter rules)
// e.g. { field: "status", operator: "equals", value: "HOT" }
// e.g. { field: "score", operator: "gte", value: "80" }
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model TargetAudienceCondition {
  id               String   @id @default(uuid())
  targetAudienceId String
  field            String // contact field name e.g. "status", "score", "source", "tags"
  operator         String // equals|not_equals|contains|gte|lte|in|not_in
  value            String // scalar string or JSON-encoded Product IDs / date range
  conditionOrder   Int      @default(0)
  createdAt        DateTime @default(now())

  targetAudience TargetAudience @relation(fields: [targetAudienceId], references: [id], onDelete: Cascade)

  @@index([targetAudienceId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// CAMPAIGN & TEMPLATE
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Campaign {
  audienceSource String?
  createdById String?
  recipientCount Int @default(0)
  failedCount Int @default(0)
  id               String         @id @default(uuid())
  tenantId         String
  targetAudienceId String? // FK to TargetAudience G�� replaces old targetAudience String?
  emailTemplateId  String? // optional FK to Template (type=Email)
  smsTemplateId    String? // optional FK to Template (type=SMS)
  name             String
  type             CampaignType
  status           CampaignStatus @default(DRAFT)
  submissionStartedAt DateTime?
  submissionLeaseId String?
  submissionLeaseUntil DateTime?
  submissionInterruptedAt DateTime?
  notificationRunVersion Int @default(0)
  submissionFinishedAt DateTime?
  subject          String?
  body             String? // inline body override when no template selected
  sentCount        Int            @default(0)
  openedCount      Int            @default(0)
  clickedCount     Int            @default(0)
  engagement       Float          @default(0)
  scheduledFor     DateTime?
  sentAt           DateTime?
  isArchived       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  targetAudience    TargetAudience?    @relation(fields: [targetAudienceId], references: [id], onDelete: SetNull)
  emailTemplate     Template?          @relation("CampaignEmailTemplate", fields: [emailTemplateId], references: [id], onDelete: SetNull)
  smsTemplate       Template?          @relation("CampaignSmsTemplate", fields: [smsTemplateId], references: [id], onDelete: SetNull)
  campaignContacts  CampaignContact[]
  metrics           CampaignMetrics[]
  emailDeliveryLogs EmailDeliveryLog[]

  @@index([tenantId, status])
  @@index([submissionFinishedAt, submissionLeaseUntil])
  @@index([tenantId, isArchived])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// MARKETING FORM
// Tenant-scoped form builder records. Fields, design, and settings are stored
// as JSON (consistent with Workflow.actions / Campaign.body patterns).
// Soft-deleted via isArchived — no hard deletes on business data.
// ─────────────────────────────────────────────────────────────────────────────
model MarketingForm {
  publicId String @unique @default(uuid())
  revision Int @default(0)
  publishedRevision Int?
  publishedVersion Int @default(0)
  publishedConfig Json?
  submissions FormSubmission[]
  id          String    @id @default(uuid())
  tenantId    String
  createdById String
  name        String
  status      String    @default("draft")   // "draft" | "published"
  fields      Json      @default("[]")       // FormField[]
  design      Json      @default("{}")       // FormDesign
  settings    Json      @default("{}")       // FormSettings
  publishedAt DateTime?
  isArchived  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id])
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([tenantId, isArchived, createdAt])
  @@index([tenantId, status])
  @@index([tenantId])

  @@unique([id, tenantId])
}

model FormSubmission {
  requestKey String?
  @@unique([formId, requestKey])
  id String @id @default(uuid())
  tenantId String
  formId String
  publishedVersion Int
  publishedConfig Json
  leadId String?
  contactId String?
  submittedAt DateTime @default(now())
  email String?
  phone String?
  values Json
  tracking Json @default("{}")
  notificationStatus String @default("not_requested")
  form MarketingForm @relation(fields: [formId, tenantId], references: [id, tenantId], onDelete: Restrict)
  lead Lead? @relation(fields: [leadId], references: [id], onDelete: Restrict)
  contact Contact? @relation(fields: [contactId], references: [id], onDelete: Restrict)
  @@index([tenantId, formId, submittedAt])
  @@index([leadId])
  @@index([contactId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CAMPAIGN METRICS (historical snapshots — separate from inline totals on Campaign)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model CampaignMetrics {
  id             String   @id @default(uuid())
  tenantId       String
  campaignId     String
  sentCount      Int      @default(0)
  deliveredCount Int      @default(0)
  openedCount    Int      @default(0)
  clickedCount   Int      @default(0)
  respondedCount Int      @default(0)
  bouncedCount   Int      @default(0)
  openRate       Float    @default(0)
  clickRate      Float    @default(0)
  deliveryRate   Float    @default(0)
  responseRate   Float    @default(0)
  bounceRate     Float    @default(0)
  snapshotAt     DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, tenantId])
  @@index([tenantId, snapshotAt])
  @@index([tenantId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// CAMPAIGN-CONTACT JUNCTION (per-contact delivery tracking)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model CampaignContact {
  email String?
  phone String?
  submittedAt DateTime? // Provider acceptance; sentAt is provider-confirmed sent
  submissionAttemptedAt DateTime? // Persisted before provider call; never automatically replayed
  providerUpdatedAt DateTime?
  personalization Json?
  messageId String? @unique
  failureReason String?
  smsWebhookReceipts SmsWebhookReceipt[]
  id           String    @id @default(uuid())
  tenantId     String
  campaignId   String
  leadId       String?
  contactId   String?
  status       String    @default("pending") // pending|submitted|retrying|sent|failed|excluded|delivered|opened|clicked|bounced|unsubscribed
  sentAt       DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  bouncedAt    DateTime?
  unsubscribed Boolean   @default(false)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact  Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)

  @@unique([campaignId, leadId])
  @@unique([campaignId, contactId])
  @@unique([id, tenantId])
  @@index([campaignId, tenantId, status])
  @@index([tenantId])
}

// Delivery identities only; message bodies and gateway credentials are never stored here.
model SmsWebhookReceipt {
  idempotencyKey String @id
  tenantId String
  campaignContactId String
  createdAt DateTime @default(now())
  campaignContact CampaignContact @relation(fields: [campaignContactId, tenantId], references: [id, tenantId], onDelete: Cascade)
  @@index([campaignContactId])
  @@index([tenantId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// TEMPLATE (single model, type = Email | SMS)
// Campaign links to this via emailTemplateId or smsTemplateId
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Template {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  type       String // "Email" | "SMS"
  category   String?
  subject    String? // email only
  content    String
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant           Tenant     @relation(fields: [tenantId], references: [id])
  campaignsAsEmail Campaign[] @relation("CampaignEmailTemplate")
  campaignsAsSms   Campaign[] @relation("CampaignSmsTemplate")

  @@index([tenantId, type, isArchived])
  @@index([tenantId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// WORKFLOW & EXECUTION CHAIN
// conditions and actions stored as typed JSON (never eval()'d)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Workflow {
  version     Int      @default(1)
  status      String   @default("DRAFT")
  activatedById String?
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  trigger     String // e.g. "deal.stage_changed" | "contact.created" | "task.overdue"
  conditions  Json? // WorkflowCondition[] typed JSON
  actions     Json // WorkflowAction[] typed JSON
  isActive    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant                  @relation(fields: [tenantId], references: [id])
  triggerRecords WorkflowTriggerRecord[]
  activatedBy    User? @relation("WorkflowActivator", fields: [activatedById, tenantId], references: [id, tenantId], onDelete: Restrict)

  @@index([tenantId, isActive])
  @@index([tenantId])

  @@unique([id, tenantId])
}

model WorkflowTriggerRecord {
  eventId     String?
  id          String   @id @default(uuid())
  tenantId    String
  workflowId  String
  triggerType String
  entityType  String
  entityId    String
  triggeredAt DateTime @default(now())
  payload     Json?

  tenant   Tenant                 @relation(fields: [tenantId], references: [id])
  workflow Workflow               @relation(fields: [workflowId, tenantId], references: [id, tenantId])
  runs     WorkflowExecutionRun[]

  @@unique([tenantId, workflowId, eventId], map: "workflow_event_once")
  @@index([tenantId, workflowId])
  @@index([tenantId, triggeredAt])
  @@index([tenantId])

  @@unique([id, workflowId, tenantId])
}

model WorkflowExecutionRun {
  workflowVersion Int?
  definitionSnapshot Json?
  id           String    @id @default(uuid())
  tenantId     String
  workflowId   String
  triggerId    String
  entityType   String
  entityId     String
  status       String    @default("running") // running|completed|failed|skipped
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  errorMessage String?

  tenant  Tenant                  @relation(fields: [tenantId], references: [id])
  trigger WorkflowTriggerRecord   @relation(fields: [triggerId, workflowId, tenantId], references: [id, workflowId, tenantId])
  steps   WorkflowExecutionStep[]

  @@index([tenantId, workflowId, status])
  @@index([tenantId, startedAt])
  @@index([tenantId])

  @@unique([id, tenantId])
}

model WorkflowExecutionStep {
  id          String   @id @default(uuid())
  tenantId    String
  executionId String
  stepIndex   Int
  actionType  String // create_task|send_email|assign_owner|update_field|send_sms|change_status|...
  status      String // success|failed|skipped
  output      Json?
  error       String?
  executedAt  DateTime @default(now())

  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  execution WorkflowExecutionRun @relation(fields: [executionId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@index([executionId])
  @@unique([executionId, stepIndex])
  @@index([tenantId])
}

// -----------------------------------------------------
