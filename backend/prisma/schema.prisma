  task Task @relation(fields: [taskId, tenantId], references: [id, tenantId], onDelete: Cascade)
  contact Contact @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([taskId, contactId])
  @@index([tenantId, contactId])
}

// Explicit Task links preserve tenant integrity on both sides.
model TaskDeal {
  taskId String
  dealId String
  tenantId String
  position Int @default(0)
  task Task @relation(fields: [taskId, tenantId], references: [id, tenantId], onDelete: Cascade)
  deal Deal @relation(fields: [dealId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([taskId, dealId])
  @@index([tenantId, dealId])
}

// Explicit Task links preserve tenant integrity on both sides.
model TaskAccount {
  taskId String
  accountId String
  tenantId String
  position Int @default(0)
  task Task @relation(fields: [taskId, tenantId], references: [id, tenantId], onDelete: Cascade)
  account Account @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Cascade)

  @@id([taskId, accountId])
  @@index([tenantId, accountId])
}

model RecordFile {
  pendingModule String?
  dealId String?
  deal Deal? @relation(fields: [dealId, tenantId], references: [id, tenantId], onDelete: Cascade)
  @@index([tenantId, dealId])
  id String @id @default(uuid())
  tenantId String
  leadId String?
  contactId String?
  accountId String?
  uploadedById String
  name String
  size Int
  type String
  objectKey String
  uploadedAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  lead Lead? @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)
  contact Contact? @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Cascade)
  account Account? @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  uploadedBy User @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([tenantId, leadId])
  @@index([tenantId, contactId])
  @@index([tenantId, accountId])
  @@index([tenantId, pendingModule, uploadedAt])
  @@index([objectKey])
}

// Organization-wide product defaults; Deals retain their original monetary snapshot.
model ProductInterest {
  id        String   @id @default(uuid())
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(200)
  dealValue Decimal  @db.Decimal(14, 2)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deals     Deal[]

  leadLinks LeadProductInterest[]
  contactLinks ContactProductInterest[]
  accountLinks AccountProductInterest[]
  @@unique([id, tenantId])

  @@index([tenantId, active])
}

model LeadProductInterest {
  leadId String
  productInterestId String
  tenantId String
  position Int @default(0)
  lead Lead @relation(fields: [leadId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product ProductInterest @relation(fields: [productInterestId, tenantId], references: [id, tenantId], onDelete: Restrict)
  @@id([leadId, productInterestId])
  @@index([tenantId, productInterestId])
}

model ContactProductInterest {
  contactId String
  productInterestId String
  tenantId String
  position Int @default(0)
  interested Boolean @default(true)
  activeProduct Boolean @default(false)
  contact Contact @relation(fields: [contactId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product ProductInterest @relation(fields: [productInterestId, tenantId], references: [id, tenantId], onDelete: Restrict)
  @@id([contactId, productInterestId])
  @@index([tenantId, productInterestId])
}

model AccountProductInterest {
  accountId String
  productInterestId String
  tenantId String
  position Int @default(0)
  interested Boolean @default(true)
  activeProduct Boolean @default(false)
  account Account @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Cascade)
  product ProductInterest @relation(fields: [productInterestId, tenantId], references: [id, tenantId], onDelete: Restrict)
  @@id([accountId, productInterestId])
  @@index([tenantId, productInterestId])
}

// One explicit Deal selection per provider account/thread; historical messages stay separate.
model MailboxThreadAssociation {
  accountId String
  threadId String
  tenantId String
  dealId String
  linkedAt DateTime @default(now())
  account EmailAccount @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  deal Deal @relation(fields: [dealId, tenantId], references: [id, tenantId], onDelete: Restrict)
  @@id([accountId, threadId])
  @@index([tenantId, dealId])
}

// Persistent identity of a manual multi-Product Deal submission.
model DealCreationReceipt {
  tenantId String
  idempotencyKey String
  actorId String
  requestHash String
  dealIds String[]
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@id([tenantId, idempotencyKey])
}
