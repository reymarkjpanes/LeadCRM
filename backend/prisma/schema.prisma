// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// PASSWORD RESET TOKEN
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model PasswordResetToken {
  userId    String?
  id        String   @id @default(uuid())
  email     String
  token     String   @unique // SHA-256 of the link token; never the bearer secret
  submissionStatus String @default("LEGACY") // LEGACY|PENDING|ACCEPTED|UNCONFIRMED
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
  @@index([userId, createdAt])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��

// ═══════════════════════════════════════════════════════════════════════
// EMAIL VERIFICATION TOKEN (account security)
// Stores SHA-256 hash of the plaintext token. Single-use, time-limited.
// ═══════════════════════════════════════════════════════════════════════

// EMAIL ACCOUNT (Gmail OAuth2 integration per user)
// Stores encrypted tokens for Gmail API access.
// Each user can connect ONE Gmail account per tenant.
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model EmailAccount {
  notificationIncidentId String?
  notificationFailedAt DateTime?
  id             String    @id @default(uuid())
  tenantId       String
  userId         String
  provider       String    @default("gmail") // "gmail" | future: "outlook"
  email          String // the connected Gmail address
  accessToken    String // encrypted G�� never log or expose
  refreshToken   String? // encrypted G�� needed for offline access
  tokenExpiresAt DateTime?
  scopes         String[] // granted OAuth scopes
  isActive               Boolean  @default(true)
  lastSyncAt     DateTime?
  syncCursor     String? // Gmail history ID for incremental sync
  connectedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  syncLeaseUntil DateTime?
  syncLeaseId String?
  syncPageToken String?
  syncBaselineHistoryId String?
  syncError String?
  syncScopeHash String?
  syncBatch Json?
  syncQueryIndex Int @default(0)
  syncRequestedAt DateTime?
  syncRetryAt DateTime?
  syncCheckedAt DateTime?
  mailboxVersion Int @default(0)
  messages MailboxMessage[]
  scheduledEmails ScheduledMailboxEmail[]
  sendReceipts MailboxSendReceipt[]

  @@unique([tenantId, userId, provider])
  @@index([tenantId, userId])
  @@index([tenantId, isActive])

  @@unique([id, tenantId])
  threadAssociations MailboxThreadAssociation[]
}

// Durable interactive-send claims prevent retrying uncertain provider deliveries.
model MailboxSendReceipt {
  id String @id @default(uuid())
  tenantId String
  accountId String
  requestId String
  payloadHash String
  status String @default("sending")
  providerMessageId String?
  providerThreadId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account EmailAccount @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  @@unique([accountId, requestId])
}

// One-time OAuth challenges are bound to the initiating staff session.
model MailboxOAuthState {
  stateHash String @id
  tenantId String
  userId String
  sessionHash String
  verifier String
  expiresAt DateTime
  @@index([expiresAt])
}

model MailboxMessage {
  id String @id @default(uuid())
  tenantId String
  accountId String
  providerMessageId String
  threadId String
  direction String
  from String
  fromAddress String @default("")
  recipients String[]
  recipientAddresses String[] @default([])
  ccRecipients String[] @default([])
  replyToAddress String?
  sourceMessageId String?
  draftId String?
  crmDraft Boolean @default(false)
  subject String
  body String @db.Text
  snippet String
  labels String[]
  sentAt DateTime
  rfcMessageId String?
  rfcInReplyTo String?
  rfcReferences String[] @default([])
  attachments Json @default("[]")
  leadId String?
  contactId String?
  dealId String?
  meaningful Boolean @default(false)
  readyToClose Boolean @default(false)
  engagementRuleVersion Int @default(0)
  needsDealAssociation Boolean @default(false)
  createdAt DateTime @default(now())
  account EmailAccount @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  @@unique([accountId, providerMessageId])
  @@index([tenantId, accountId, threadId, sentAt])
  @@index([tenantId, leadId, sentAt])
  @@index([tenantId, contactId, sentAt])
  @@index([tenantId, accountId, fromAddress, sentAt])
  @@index([recipientAddresses], type: Gin)
}

// A Gmail draft is the delivery payload. Keep accepted/uncertain deliveries durable
// so a restarted worker never blindly repeats a send.
model ScheduledMailboxEmail {
  id String @id @default(uuid())
  tenantId String
  accountId String
  createdById String
  requestId String
  draftId String
  recipients String[]
  subject String
  scheduledAt DateTime
  status String @default("pending")
  attemptCount Int @default(0)
  leaseId String?
  leaseUntil DateTime?
  retryAt DateTime?
  providerMessageId String?
  providerThreadId String?
  lastError String?
  sentAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  account EmailAccount @relation(fields: [accountId, tenantId], references: [id, tenantId], onDelete: Restrict)
  @@unique([accountId, requestId])
  @@unique([accountId, draftId])
  @@index([status, scheduledAt, retryAt])
  @@index([tenantId, accountId, scheduledAt])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// SMS QUEUE (Local Android Gateway)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// EMAIL EVENT (Tracking opens, clicks, etc.)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model EmailEvent {
  providerEventKey String? @unique
  id            String   @id @default(uuid())
  tenantId      String
  deliveryLogId String
  eventType     String // open|click|bounce|unsubscribe
  url           String? // for clicks
  userAgent     String?
