// ─────────────────────────────────────────────────────────────────────────────
// STRIPE WEBHOOK EVENT LOG
// Stores every inbound Stripe webhook for idempotency, debugging, and replay.
// No tenantId — webhook events are platform-level (cross-tenant).
// ─────────────────────────────────────────────────────────────────────────────
model StripeWebhookEvent {
  id            String             @id @default(uuid())
  stripeEventId String             @unique // evt_xxx — Stripe's unique event ID
  type          String             // e.g. "checkout.session.completed"
  payload       Json               // Full event object from Stripe
  status        WebhookEventStatus @default(RECEIVED)
  error         String?            // Error message if processing failed
  attempts      Int                @default(0)
  processedAt   DateTime?
  createdAt     DateTime           @default(now())

  @@index([type])
  @@index([status])
  @@index([createdAt])
}
