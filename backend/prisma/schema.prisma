// LeadCRM - Prisma Schema
// Single source of truth for all database models
// ORM: Prisma 5 | DB: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}


// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// ENUMS
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��

enum TenantStatus {
  SANDBOX
  ACTIVE
  SUSPENDED
  CANCELLED
  DELETED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum PlanType {
  FREE
  PRO
  ENTERPRISE
}

enum BillingCycle {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ContactStatus {
  HOT
  WARM
  COLD
  CANCELLED
  CLOSED
}

// System-owned lifecycle position G�� never manually editable via status controls.
// REQ131: ContactStatus (above) is human-owned and never changed by automation.
// This enum is the system-owned complement.
enum ContactLifecycleStage {
  LEAD // captured, not yet qualified
  QUALIFIED // qualified, ready for opportunity
  CONTACT // known person, active relationship
  CUSTOMER // has at least one won deal
  CHURNED // former customer, no active deals
  DISQUALIFIED // dead G�� will not proceed
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum CampaignType {
  EMAIL
  SMS
  MULTI_CHANNEL
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  SCHEDULED
}

// Actions that can be manually performed on a deal
enum DealActionType {
  UPDATE_FIELD
  ASSIGN_AGENT
  CHANGE_STATUS
  SEND_EMAIL
  SEND_SMS
  ADD_NOTE
  CREATE_TASK
  CHANGE_STAGE
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// SYSTEM ADMIN (cross-tenant G�� LeadCRM operators)
// No tenantId G�� these users own the platform itself
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model SystemAdmin {
  id           String   @id @default(uuid())
  email        String   @unique
  firstName    String
  lastName     String
  passwordHash String
  isActive               Boolean  @default(true)
  // -- Payment methods (per-plan config, stored as JSON) ------------
  paymentMethods         Json     @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// PRICING PLAN (global G�� not tenant-scoped)
// Managed by SystemAdmin, consumed by Subscription
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model PricingPlan {
  id                     String   @id @default(uuid())
  name                   String   @unique // "Free" | "Pro" | "Enterprise"
  planType               PlanType
  monthlyPrice           Float    @default(0)
  quarterlyPrice         Float    @default(0)
  annualPrice            Float    @default(0)
  maxUsers               Int?
  maxContacts            Int?
  maxDeals               Int?
  storageLimit           Int? // MB
  isActive               Boolean  @default(true)
  // -- Payment methods (per-plan config, stored as JSON) ------------
  paymentMethods         Json     @default("[]")
  // -- Stripe --------------------------------------------------------
  stripeProductId        String?  @unique // prod_xxx � one Product per plan
  stripeMonthlyPriceId   String?  @unique // price_xxx for monthly billing
  stripeQuarterlyPriceId String?  @unique // price_xxx for quarterly billing
  stripeAnnualPriceId    String?  @unique // price_xxx for annual billing
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  features      PlanFeature[]
  subscriptions Subscription[]
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// PLAN FEATURE
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model PlanFeature {
  id          String  @id @default(uuid())
  planId      String
  name        String // e.g. "Workflow Automation", "Gmail Integration"
  description String?
  isEnabled   Boolean @default(true) // false = feature shown as disabled/struck-through on pricing card

  plan PricingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// TENANT
// plan/subscriptionStatus are denormalized caches for fast plan-gating.
// Subscription is the authoritative billing source.
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Tenant {
  id                 String             @id @default(uuid())
  name               String
  slug               String             @unique
  industry           String?
  companySize        String? // "1-10" | "11-50" | "51-200" | "200+"
  email              String?
  phone              String?
  address            String?
  status             TenantStatus       @default(SANDBOX)
  subscriptionStatus SubscriptionStatus @default(TRIAL)
  plan               PlanType           @default(FREE) // denorm cache G�� source of truth = Subscription
  trialEndsAt        DateTime?
  subscriptionEndsAt DateTime?
  maxUsers           Int?
  maxContacts        Int?
  maxDeals           Int?
  approvedById       String? // SystemAdmin id who approved
  approvedAt         DateTime?
  // -- Onboarding ----------------------------------------------------
  onboardingStep        Int       @default(0) // 0=not started, 1=workspace, 2=invite, 3=tour
  onboardingCompletedAt DateTime?
  // -- Stripe --------------------------------------------------------
  stripeCustomerId   String?            @unique // cus_xxx � one customer per tenant
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  users              User[]
  userRoles          UserRole[]
  roleDefinitions    RoleDefinition[]
  sessions           Session[]
  invitations        TenantInvitation[]
  subscriptions      Subscription[]
  paymentMethods     PaymentMethod[]
  organizations      Account[]
  leads              Lead[]
  contacts           Contact[]
  pipelines          Pipeline[]
  stages             Stage[]
  deals              Deal[]
  dealActions        DealAction[]
  leadDeals          LeadDeal[]
  contactDeals       ContactDeal[]
  dealStageHistories DealStageHistory[]
  tasks              Task[]
  activities         Activity[]
  campaigns          Campaign[]
  campaignContacts   CampaignContact[]
  campaignMetrics    CampaignMetrics[]
  templates          Template[]
  targetAudiences    TargetAudience[]
  workflows          Workflow[]
  wfTriggerRecords   WorkflowTriggerRecord[]
  wfExecutionRuns    WorkflowExecutionRun[]
  wfExecutionSteps   WorkflowExecutionStep[]
  invoices           Invoice[]
  paymentTxns        PaymentTransaction[]
  notifications      Notification[]
  auditLogs          AuditLog[]
  emailDeliveryLogs  EmailDeliveryLog[]
  documents          TenantDocument[]
  environments       Environment[]
  SMSQueue           SMSQueue[]
  EmailEvent         EmailEvent[]
  AutomationRule     AutomationRule[]
  userPreferences    UserPreference[]
  tenantPreferences  TenantPreference[]
  leadImports        LeadImport[]
  accountImports     AccountImport[]
  contactImports     ContactImport[]
  tenantGroups       TenantGroup[]
  tenantGroupMembers TenantGroupMember[]
  tenantDomains      TenantDomain[]
  tenantDomainSettings TenantDomainSettings?
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// SUBSCRIPTION (billing source of truth)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Subscription {
  id                      String             @id @default(uuid())
  tenantId                String
  planId                  String
  billingCycle            BillingCycle
  status                  SubscriptionStatus @default(TRIAL)
  amount                  Float
  startDate               DateTime
  endDate                 DateTime?
  nextBillingDate         DateTime?
  cancelledAt             DateTime?
  // -- Pending Downgrade ─────────────────────────────────────────────
  pendingPlanId           String?            // Plan ID to switch to at period end
  pendingBillingCycle     String?            // Target billing cycle for downgrade
  pendingDowngradeAt      DateTime?          // When the downgrade takes effect
  // -- Seats ─────────────────────────────────────────────────────────
  additionalSeats              Int       @default(0) // Extra seats beyond plan base
  stripeAdditionalSeatItemId   String?   // si_xxx — Stripe subscription item for seats
  // -- Stripe --------------------------------------------------------
  stripeSubscriptionId    String?            @unique // sub_xxx
  stripeCheckoutSessionId String? // cs_xxx � transient, kept for audit trail
  createdAt               DateTime           @default(now())
  updatedAt               DateTime           @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  plan     PricingPlan @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([tenantId, status])
  @@index([stripeSubscriptionId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// PAYMENT METHOD (saved methods per tenant)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model PaymentMethod {
  id            String   @id @default(uuid())
  tenantId      String
  methodName    String // "GCash" | "Maya" | "Credit Card" | "Bank Transfer"
  accountName   String?
  accountNumber String? // masked G�� e.g. "****1234"
  isDefault     Boolean  @default(false)
  isActive               Boolean  @default(true)
  // -- Payment methods (per-plan config, stored as JSON) ------------
  paymentMethods         Json     @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  transactions PaymentTransaction[]

  @@index([tenantId, isActive])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// USER
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model User {
  id            String     @id @default(uuid())
  tenantId      String
  email         String
  firstName     String
  lastName      String
  passwordHash  String? // nullable � OAuth-only users have no password
  phone         String?
  jobTitle      String?
  department    String?
  avatarUrl     String?
  timeZone      String?
  lastLoginAt   DateTime?
  // role kept as String for JWT compatibility during UserRole migration.
  // New code should read role from UserRole junction; this is the legacy fallback.
  role          String     @default("Sales Rep")
  status        UserStatus @default(ACTIVE)
  emailVerified DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  userRoles          UserRole[]
  sessions           Session[]
  invitationsSent    TenantInvitation[] @relation("InvitedByUser")
  organizationsOwned Account[]
  assignedLeads      Lead[]             @relation("AssignedLeads")
  createdLeads       Lead[]             @relation("CreatedLeads")
  updatedLeads       Lead[]             @relation("UpdatedLeads")
  convertedLeads     Lead[]             @relation("ConvertedLeads")
  assignedCustomers  Contact[]          @relation("AssignedCustomers")
  ownedContacts      Contact[]          @relation("OwnedContacts")

  assignedDeals        Deal[]             @relation("AssignedDeals")
  ownedDeals           Deal[]             @relation("OwnedDeals")
  leadDealsAdded       LeadDeal[]
  customerDealsAdded   ContactDeal[]
  dealStageHistories   DealStageHistory[]
  dealActionsPerformed DealAction[]
  assignedTasks        Task[]             @relation("AssignedTasks")
  tasksAssignedByMe    Task[]             @relation("TaskAssignedBy")
  completedTasks       Task[]             @relation("TaskCompletedBy")
  activitiesCreated    Activity[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  oauthAccounts        OAuthAccount[]
  userPreferences      UserPreference[]
  leadImports          LeadImport[]
  accountImports       AccountImport[]
  contactImports       ContactImport[]
  emailVerificationTokens EmailVerificationToken[]
  groupMemberships TenantGroupMember[]

  @@unique([tenantId, email])
  @@index([tenantId, status])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// ROLE DEFINITION
// permissions String[] removed G�� use RolePermission table instead
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model RoleDefinition {
  id           String   @id @default(uuid())
  tenantId     String
  name         String
  description  String?
  isSystemRole Boolean  @default(false)
  isArchived   Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant             @relation(fields: [tenantId], references: [id])
  userRoles   UserRole[]
  invitations TenantInvitation[]
  permissions RolePermission[]

  @@unique([tenantId, name])
  @@index([tenantId, isArchived])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// ROLE PERMISSION (per-module CRUD flags)
// One row per module per role.
// module examples: contacts | deals | campaigns | workflows | billing | reports | users | settings
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model RolePermission {
  id        String  @id @default(uuid())
  tenantId  String
  roleId    String
  module    String // e.g. "contacts", "deals", "campaigns"
  canView   Boolean @default(false)
  canCreate Boolean @default(false)
  canEdit   Boolean @default(false)
  canDelete Boolean @default(false)

  role RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, module])
  @@index([roleId])
  @@index([tenantId, module])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// USER ROLE (JUNCTION)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model UserRole {
  id       String @id @default(uuid())
  userId   String
  roleId   String
  tenantId String

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  tenant Tenant         @relation(fields: [tenantId], references: [id])

  @@unique([userId, roleId, tenantId])
  @@index([userId, tenantId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// SESSION (Token Revocation)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Session {
  id           String    @id @default(uuid())
  userId       String
  tenantId     String
  tokenHash    String    @unique // SHA-256 of JWT, never plaintext
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([userId, tenantId])
  @@index([tokenHash])
}

// ---------------------------------------------
// OAUTH ACCOUNT
// Links a social provider account to a LeadCRM user.
// One user can have multiple OAuth providers linked.
// ---------------------------------------------
model OAuthAccount {
  id                String    @id @default(uuid())
  userId            String
  tenantId          String
  provider          String // "google" | "github" | "microsoft"
  providerAccountId String // subject claim from the OAuth provider (immutable)
  accessToken       String? // encrypted at rest � short-lived
  refreshToken      String? // encrypted at rest � long-lived
  idToken           String? // raw OIDC id_token for verification
  tokenType         String? // "Bearer"
  scope             String? // e.g. "openid email profile"
  expiresAt         DateTime? // access token expiry
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One provider account can only be linked to one user
  @@unique([provider, providerAccountId])
  @@index([userId, tenantId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// TENANT INVITATION
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model TenantInvitation {
  id          String    @id @default(uuid())
  tenantId    String
  email       String
  roleId      String
  token       String    @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  invitedBy User           @relation("InvitedByUser", fields: [invitedById], references: [id])
  role      RoleDefinition @relation(fields: [roleId], references: [id])

  @@index([token])
  @@index([email, tenantId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// TENANT GROUP
// ─────────────────────────────────────────────────────────────
model TenantGroup {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant              @relation(fields: [tenantId], references: [id])
  members TenantGroupMember[]

  @@index([tenantId])
}

// TENANT GROUP MEMBER (junction: group ↔ user)
// ─────────────────────────────────────────────────────────────
model TenantGroupMember {
  id       String @id @default(uuid())
  groupId  String
  userId   String
  tenantId String

  group  TenantGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant      @relation(fields: [tenantId], references: [id])

  @@unique([groupId, userId])
  @@index([tenantId])
  @@index([groupId])
  @@index([userId])
}

// TENANT DOMAIN
// ─────────────────────────────────────────────────────────────
model TenantDomain {
  id         String    @id @default(uuid())
  tenantId   String
  domain     String
  isVerified Boolean   @default(false)
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, domain])
  @@index([tenantId])
}

// TENANT DOMAIN SETTINGS
// ─────────────────────────────────────────────────────────────
model TenantDomainSettings {
  id                     String   @id @default(uuid())
  tenantId               String   @unique
  restrictToEmailDomains Boolean  @default(false)
  joinPolicy             String   @default("after_approval") // "instantly" | "after_approval"
  defaultRole            String   @default("Sales Rep")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// TENANT DOCUMENT (onboarding files, contracts, etc.)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model TenantDocument {
  id           String    @id @default(uuid())
  tenantId     String
  fileName     String
  documentType String // "contract" | "business_permit" | "id_proof" | "other"
  filePath     String // URL to object storage G�� NOT base64
  fileSize     Int? // bytes
  status       String    @default("pending") // pending|verified|rejected
  uploadedAt   DateTime  @default(now())
  verifiedById String? // SystemAdmin id
  verifiedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// ENVIRONMENT (tenant environment monitoring)
// Tracks resource usage per tenant environment
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Environment {
  id            String    @id @default(uuid())
  tenantId      String
  envCode       String // e.g. "prod" | "staging" | "sandbox"
  type          String // "production" | "staging" | "sandbox"
  cpuUsage      Float? // percentage
  ramUsage      Float? // percentage
  storageUsage  Float? // percentage
  uptimePct     Float? // percentage
  isDefault     Boolean   @default(false)
  lastCheckedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, envCode])
  @@index([tenantId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// ORGANIZATION
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Account {
  id               String    @id @default(uuid())
  tenantId         String
  assignedUserId   String?
  name             String
  industry         String?
  size             String? // "1-10" | "11-50" | "51-200" | "200+"
  website          String?
  taxId            String?
  notes            String?   @db.Text
  internalNotes    String?   @db.Text
  tags             String[]
  productInterests String[]
  activeProducts   String[]
  customerType     String    @default("Prospect") // Prospect | Active Customer | Inactive Customer | Former Customer
  customerSince    DateTime?
  address          String?
  city             String?
  province         String?
  country          String?   @default("Philippines")
  isArchived       Boolean   @default(false)
  deletedAt        DateTime?
  deletedBy        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  assignedUser User?      @relation(fields: [assignedUserId], references: [id])
  leads        Lead[]
  deals        Deal[]
  activities   Activity[]
  contacts     Contact[]

  @@index([tenantId, isArchived])
  @@index([tenantId, name])
  @@index([tenantId, createdAt])
  @@index([tenantId, assignedUserId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// CONTACT
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// LEAD
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Lead {
  id                  String    @id @default(uuid())
  tenantId            String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt
  companyName         String?
  address             String?
  firstName           String
  lastName            String
  phone               String?
  email               String?
  description         String?   @db.Text
  website             String?
  productInterest     String[]
  source              String?
  assignedUserId      String?
  status              String    @default("Inquiry")
  accountId           String?
  createdById         String?
  updatedById         String?
  lastStatusChangedAt DateTime?
  // Conversion tracking — set when lead is converted to a Contact
  contactId           String?
  convertedAt         DateTime?
  convertedById       String?

  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  account          Account? @relation(fields: [accountId], references: [id])
  assignedUser     User?    @relation("AssignedLeads", fields: [assignedUserId], references: [id])
  createdBy        User?    @relation("CreatedLeads", fields: [createdById], references: [id])
  updatedBy        User?    @relation("UpdatedLeads", fields: [updatedById], references: [id])
  convertedContact Contact? @relation("ConvertedFromLead", fields: [contactId], references: [id])
  convertedBy      User?    @relation("ConvertedLeads", fields: [convertedById], references: [id])

  leadDeals         LeadDeal[]
  deals             Deal[]
  tasks             Task[]
  activities        Activity[]
  campaignContacts  CampaignContact[]
  emailDeliveryLogs EmailDeliveryLog[]
  SMSQueue          SMSQueue[]
  invoices          Invoice[]

  @@index([tenantId, status])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, email])
  @@index([tenantId, createdAt])
  @@index([tenantId, accountId])
  @@index([tenantId, createdById])
  @@index([tenantId, contactId])
}

// -----------------------------------------------------
// CONTACT
// ─────────────────────────────────────────────────────────────────────────────
// CONTRACT PHASE COMPLETE (ADR-001) — Organization model and Contact.organizationId removed.
// The canonical company link for Contact is now Contact.accountId → Account exclusively.
// Migration: remove_organization_model
// ─────────────────────────────────────────────────────────────────────────────

// -----------------------------------------------------
model Contact {
  id                  String               @id @default(uuid())
  tenantId            String
  // Canonical company link (ADR-001) — Contact.accountId → Account
  accountId           String?
  assignedUserId      String?
  ownerId             String?
  firstName           String
  lastName            String
  email               String?
  phone               String?
  company             String?
  jobTitle            String?
  linkedinUrl         String?
  status              ContactStatus        @default(WARM)
  score               Int                  @default(75)
  source              String?
  notes               String?
  lastContactedAt     DateTime?
  convertedAt         DateTime?
  doNotContact        Boolean              @default(false)
  isArchived          Boolean              @default(false)
  archiveReason       String?
  deletedAt           DateTime?
  deletedBy           String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  activeProducts      String[]
  address             String?
  customerSince       DateTime?
  customerType        String               @default("Prospect")
  productInterests    String[]
  lifecycleStage      ContactLifecycleStage @default(LEAD)
  recordType          String?
  qualifiedAt         DateTime?
  disqualifiedReason  String?

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  account      Account?      @relation(fields: [accountId], references: [id])
  assignedUser User?         @relation("AssignedCustomers", fields: [assignedUserId], references: [id])
  owner        User?         @relation("OwnedContacts", fields: [ownerId], references: [id])

  convertedFromLeads Lead[]             @relation("ConvertedFromLead")
  contactDeals       ContactDeal[]
  deals              Deal[]
  tasks              Task[]
  activities         Activity[]
  campaignContacts   CampaignContact[]
  emailDeliveryLogs  EmailDeliveryLog[]
  SMSQueue           SMSQueue[]
  invoices           Invoice[]

  @@index([tenantId, status])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, email])
  @@index([tenantId, createdAt])
  @@index([tenantId, accountId])
  @@map("Contact")
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// PIPELINE & STAGE
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Pipeline {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  type        String? // e.g. "Sales" | "Service" | "Onboarding"
  templateKey String? // identifies seeded templates for upgrades (e.g. "sales-inquiries")
  isDefault   Boolean  @default(false)
  currency    String?  @default("PHP")
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  stages Stage[]
  deals  Deal[]

  @@index([tenantId, isArchived])
}

model Stage {
  id              String   @id @default(uuid())
  pipelineId      String
  tenantId        String // defence-in-depth: derived from Pipeline.tenantId at creation, never independently editable
  name            String
  order           Int
  probability     Int? // 0-100 for revenue forecasting
  color           String? // hex e.g. "#3fb950"
  description     String?
  isWon           Boolean  @default(false) // terminal: deal won
  isLost          Boolean  @default(false) // terminal: deal lost
  isDefault       Boolean  @default(false) // starting stage for new deals
  requiredFields  String[] // Deal fields required before entry (REQ089) e.g. ["accountId", "value"]
  rottenAfterDays Int? // days after which a deal in this stage is flagged stale
  createdAt       DateTime @default(now())

  pipeline               Pipeline           @relation(fields: [pipelineId], references: [id])
  tenant                 Tenant             @relation(fields: [tenantId], references: [id])
  deals                  Deal[]
  dealStageHistoriesNew  DealStageHistory[] @relation("NewStage")
  dealStageHistoriesPrev DealStageHistory[] @relation("PreviousStage")

  @@index([pipelineId, order])
  @@index([tenantId, pipelineId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// DEAL
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Deal {
  id                String    @id @default(uuid())
  tenantId          String
  pipelineId        String
  stageId           String
  leadId            String?
  customerId        String? // legacy singular FK G�� use ContactDeal for new multi-contact deals
  accountId         String?
  assignedUserId    String?
  ownerId           String? // original deal owner (immutable)
  title             String
  value             Float?
  currency          String?   @default("PHP")
  billingFrequency  String? // "monthly" | "one_time" | "annual" | "quarterly"
  priority          Priority  @default(MEDIUM)
  expectedCloseDate DateTime?
  closedAt          DateTime? // stamped when stage.isWon or stage.isLost = true
  lostReason        String?
  description       String?
  leadSource        String?
  industry          String?
  productInterests  String[]
  address           String?
  tags              String[] // normalized to array G�� consistent with Contact.tags and Organization.tags
  order             Int       @default(0)
  isArchived        Boolean   @default(false)
  archiveReason     String?
  deletedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id])
  pipeline       Pipeline           @relation(fields: [pipelineId], references: [id])
  stage          Stage              @relation(fields: [stageId], references: [id])
  lead           Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact        Contact?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  organization   Account?           @relation(fields: [accountId], references: [id])
  assignedUser   User?              @relation("AssignedDeals", fields: [assignedUserId], references: [id])
  owner          User?              @relation("OwnedDeals", fields: [ownerId], references: [id])
  leadDeals      LeadDeal[]
  contactDeals   ContactDeal[]
  stageHistories DealStageHistory[]
  actions        DealAction[]
  tasks          Task[]
  activities     Activity[]
  invoices       Invoice[]

  @@index([tenantId, stageId])
  @@index([tenantId, pipelineId])
  @@index([tenantId, assignedUserId])
  @@index([tenantId, createdAt])
  @@index([tenantId, isArchived])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// CONTACT-DEAL JUNCTION (multi-contact deals)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model LeadDeal {
  id        String   @id @default(uuid())
  leadId    String
  dealId    String
  tenantId  String
  role      String?
  addedById String?
  addedAt   DateTime @default(now())

  lead    Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal    Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tenant  Tenant @relation(fields: [tenantId], references: [id])
  addedBy User?  @relation(fields: [addedById], references: [id])

  @@unique([leadId, dealId])
  @@index([dealId, tenantId])
  @@index([leadId, tenantId])
}

model ContactDeal {
  id        String   @id @default(uuid())
  contactId String
  dealId    String
  tenantId  String
  role      String?
  addedById String?
  addedAt   DateTime @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  addedBy User?   @relation(fields: [addedById], references: [id])

  @@unique([contactId, dealId])
  @@index([dealId, tenantId])
  @@index([contactId, tenantId])
  @@map("ContactDeal")
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// DEAL STAGE HISTORY
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model DealStageHistory {
  id              String   @id @default(uuid())
  tenantId        String
  dealId          String
  previousStageId String?
  newStageId      String
  movedById       String
  movedAt         DateTime @default(now())
  timeInPrevStage Int? // minutes spent in previous stage (computed on insert)
  note            String?

  tenant        Tenant @relation(fields: [tenantId], references: [id])
  deal          Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  movedBy       User   @relation(fields: [movedById], references: [id])
  newStage      Stage  @relation("NewStage", fields: [newStageId], references: [id])
  previousStage Stage? @relation("PreviousStage", fields: [previousStageId], references: [id])

  @@index([dealId, tenantId])
  @@index([tenantId, movedAt])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// DEAL ACTION (manual actions performed on a deal)
// Mentor requirement: update_field, assign_agent, change_status, send_email, send_sms, etc.
// Distinct from automated WorkflowExecutionStep G�� these are user-initiated deal operations.
// Every DealAction also triggers an Activity entry for the timeline.
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model DealAction {
  id            String         @id @default(uuid())
  tenantId      String
  dealId        String
  performedById String
  actionType    DealActionType
  payload       Json? // e.g. { field: "status", from: "WARM", to: "HOT" } or { to: "user@email.com" }
  note          String?
  performedAt   DateTime       @default(now())

  tenant      Tenant @relation(fields: [tenantId], references: [id])
  deal        Deal   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  performedBy User   @relation(fields: [performedById], references: [id])

  @@index([dealId, tenantId])
  @@index([tenantId, actionType])
  @@index([tenantId, performedAt])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// TASK
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Task {
  id             String    @id @default(uuid())
  tenantId       String
  dealId         String?
  leadId         String?
  customerId     String?
  accountId      String?
  assignedUserId String
  assignedById   String?
  completedById  String?
  title          String
  description    String?
  status         String    @default("pending") // pending|in_progress|blocked|completed|cancelled
  priority       String    @default("Medium") // Low|Medium|High
  dueDate        DateTime
  reminderAt     DateTime?
  completedAt    DateTime?
  isArchived     Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  deal         Deal?      @relation(fields: [dealId], references: [id], onDelete: SetNull)
  lead         Lead?      @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact      Contact?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedUser User       @relation("AssignedTasks", fields: [assignedUserId], references: [id])
  assignedBy   User?      @relation("TaskAssignedBy", fields: [assignedById], references: [id])
  completedBy  User?      @relation("TaskCompletedBy", fields: [completedById], references: [id])
  activities   Activity[]

  @@index([tenantId, assignedUserId, status])
  @@index([tenantId, dueDate])
  @@index([tenantId, dealId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// ACTIVITY (unified timeline G�� typed FKs, no polymorphic)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Activity {
  id          String   @id @default(uuid())
  tenantId    String
  createdById String
  type        String // call|meeting|email|sms|note|task|workflow|stage_change|deal_action|file_upload
  title       String
  description String?
  metadata    Json?
  // Exactly one of these is non-null
  leadId      String?
  customerId  String?
  dealId      String?
  accountId   String?
  taskId      String?
  invoiceId   String?
  createdAt   DateTime @default(now())

  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  createdBy    User     @relation(fields: [createdById], references: [id])
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact      Contact? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deal         Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  organization Account? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  task         Task?    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  invoice      Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId, leadId, createdAt])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, dealId, createdAt])
  @@index([tenantId, createdAt])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// NOTIFICATION
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Notification {
  id         String    @id @default(uuid())
  tenantId   String
  userId     String
  type       String // deal_assigned|task_due|campaign_sent|workflow_failed|deal_action|...
  title      String
  body       String?
  entityType String?
  entityId   String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tenantId, isRead])
  @@index([tenantId, createdAt])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// TARGET AUDIENCE (campaign segmentation G�� no audience_contacts table)
// Contacts are resolved at query time using TargetAudienceCondition filters.
// mentor: "no need for audience_contacts, just filtration logic, query from contacts"
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model TargetAudience {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  isActive               Boolean  @default(true)
  // -- Payment methods (per-plan config, stored as JSON) ------------
  paymentMethods         Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant     Tenant                    @relation(fields: [tenantId], references: [id])
  conditions TargetAudienceCondition[]
  campaigns  Campaign[]

  @@index([tenantId, isActive])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// TARGET AUDIENCE CONDITION (filter rules)
// e.g. { field: "status", operator: "equals", value: "HOT" }
// e.g. { field: "score", operator: "gte", value: "80" }
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model TargetAudienceCondition {
  id               String   @id @default(uuid())
  targetAudienceId String
  field            String // contact field name e.g. "status", "score", "source", "tags"
  operator         String // equals|not_equals|contains|gte|lte|in|not_in
  value            String // stored as string, cast at query time
  conditionOrder   Int      @default(0)
  createdAt        DateTime @default(now())

  targetAudience TargetAudience @relation(fields: [targetAudienceId], references: [id], onDelete: Cascade)

  @@index([targetAudienceId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// CAMPAIGN & TEMPLATE
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Campaign {
  id               String         @id @default(uuid())
  tenantId         String
  targetAudienceId String? // FK to TargetAudience G�� replaces old targetAudience String?
  emailTemplateId  String? // optional FK to Template (type=Email)
  smsTemplateId    String? // optional FK to Template (type=SMS)
  name             String
  type             CampaignType
  status           CampaignStatus @default(DRAFT)
  subject          String?
  body             String? // inline body override when no template selected
  sentCount        Int            @default(0)
  openedCount      Int            @default(0)
  clickedCount     Int            @default(0)
  engagement       Float          @default(0)
  scheduledFor     DateTime?
  sentAt           DateTime?
  isArchived       Boolean        @default(false)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  targetAudience    TargetAudience?    @relation(fields: [targetAudienceId], references: [id], onDelete: SetNull)
  emailTemplate     Template?          @relation("CampaignEmailTemplate", fields: [emailTemplateId], references: [id], onDelete: SetNull)
  smsTemplate       Template?          @relation("CampaignSmsTemplate", fields: [smsTemplateId], references: [id], onDelete: SetNull)
  campaignContacts  CampaignContact[]
  metrics           CampaignMetrics[]
  emailDeliveryLogs EmailDeliveryLog[]
  SMSQueue          SMSQueue[]

  @@index([tenantId, status])
  @@index([tenantId, isArchived])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// CAMPAIGN METRICS (historical snapshots G�� separate from inline totals on Campaign)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model CampaignMetrics {
  id             String   @id @default(uuid())
  tenantId       String
  campaignId     String
  sentCount      Int      @default(0)
  deliveredCount Int      @default(0)
  openedCount    Int      @default(0)
  clickedCount   Int      @default(0)
  respondedCount Int      @default(0)
  bouncedCount   Int      @default(0)
  openRate       Float    @default(0)
  clickRate      Float    @default(0)
  deliveryRate   Float    @default(0)
  responseRate   Float    @default(0)
  bounceRate     Float    @default(0)
  snapshotAt     DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, tenantId])
  @@index([tenantId, snapshotAt])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// CAMPAIGN-CONTACT JUNCTION (per-contact delivery tracking)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model CampaignContact {
  id           String    @id @default(uuid())
  tenantId     String
  campaignId   String
  leadId       String?
  customerId   String?
  status       String    @default("pending") // pending|sent|delivered|opened|clicked|bounced|unsubscribed
  sentAt       DateTime?
  deliveredAt  DateTime?
  openedAt     DateTime?
  clickedAt    DateTime?
  bouncedAt    DateTime?
  unsubscribed Boolean   @default(false)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead     Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contact  Contact? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([campaignId, leadId])
  @@unique([campaignId, customerId])
  @@index([campaignId, tenantId, status])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// TEMPLATE (single model, type = Email | SMS)
// Campaign links to this via emailTemplateId or smsTemplateId
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Template {
  id         String   @id @default(uuid())
  tenantId   String
  name       String
  type       String // "Email" | "SMS"
  category   String?
  subject    String? // email only
  content    String
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant           Tenant     @relation(fields: [tenantId], references: [id])
  campaignsAsEmail Campaign[] @relation("CampaignEmailTemplate")
  campaignsAsSms   Campaign[] @relation("CampaignSmsTemplate")

  @@index([tenantId, type, isArchived])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// WORKFLOW & EXECUTION CHAIN
// conditions and actions stored as typed JSON (never eval()'d)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Workflow {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  trigger     String // e.g. "deal.stage_changed" | "contact.created" | "task.overdue"
  conditions  Json? // WorkflowCondition[] typed JSON
  actions     Json // WorkflowAction[] typed JSON
  isActive    Boolean  @default(false)
  isArchived  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant                  @relation(fields: [tenantId], references: [id])
  triggerRecords WorkflowTriggerRecord[]

  @@index([tenantId, isActive])
}

model WorkflowTriggerRecord {
  id          String   @id @default(uuid())
  tenantId    String
  workflowId  String
  triggerType String
  entityType  String
  entityId    String
  triggeredAt DateTime @default(now())
  payload     Json?

  tenant   Tenant                 @relation(fields: [tenantId], references: [id])
  workflow Workflow               @relation(fields: [workflowId], references: [id])
  runs     WorkflowExecutionRun[]

  @@index([tenantId, workflowId])
  @@index([tenantId, triggeredAt])
}

model WorkflowExecutionRun {
  id           String    @id @default(uuid())
  tenantId     String
  workflowId   String
  triggerId    String
  entityType   String
  entityId     String
  status       String    @default("running") // running|completed|failed|skipped
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  errorMessage String?

  tenant  Tenant                  @relation(fields: [tenantId], references: [id])
  trigger WorkflowTriggerRecord   @relation(fields: [triggerId], references: [id])
  steps   WorkflowExecutionStep[]

  @@index([tenantId, workflowId, status])
  @@index([tenantId, startedAt])
}

model WorkflowExecutionStep {
  id          String   @id @default(uuid())
  tenantId    String
  executionId String
  stepIndex   Int
  actionType  String // create_task|send_email|assign_owner|update_field|send_sms|change_status|...
  status      String // success|failed|skipped
  output      Json?
  error       String?
  executedAt  DateTime @default(now())

  tenant    Tenant               @relation(fields: [tenantId], references: [id])
  execution WorkflowExecutionRun @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([executionId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// INVOICE & PAYMENT TRANSACTION
// Invoice now links to Subscription for billing-driven invoices
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model Invoice {
  id              String    @id @default(uuid())
  tenantId        String
  subscriptionId  String? // link to Subscription for recurring billing invoices
  dealId          String?
  leadId          String?
  customerId      String?
  accountId       String?
  invoiceNumber   String // INV-2024-001 (tenant-scoped auto-generated)
  plan            String?
  amount          Float
  taxAmount       Float     @default(0)
  discountAmount  Float     @default(0)
  totalAmount     Float
  currency        String    @default("PHP")
  frequency       String // Monthly|Quarterly|Annual|One-time
  status          String    @default("Pending")
  paymentStatus   String    @default("Unpaid")
  startDate       DateTime
  dueDate         DateTime?
  nextBillingDate DateTime?
  paidAt          DateTime?
  notes           String?
  isArchived      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  tenant       Tenant               @relation(fields: [tenantId], references: [id])
  subscription Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  deal         Deal?                @relation(fields: [dealId], references: [id], onDelete: SetNull)
  lead         Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact      Contact?             @relation(fields: [customerId], references: [id], onDelete: SetNull)
  transactions PaymentTransaction[]
  activities   Activity[]

  @@index([tenantId, status, paymentStatus])
  @@index([tenantId, dueDate])
  @@index([tenantId, invoiceNumber])
}

model PaymentTransaction {
  id                      String    @id @default(uuid())
  tenantId                String
  invoiceId               String
  paymentMethodId         String? // FK to PaymentMethod (saved method) G�� nullable for ad-hoc
  amount                  Float
  currency                String    @default("PHP")
  status                  String // pending|paid|failed|refunded|partially_refunded
  transactionRef          String? // internal or external reference number
  paymongoPaymentId       String?   @unique
  paymongoPaymentUrl      String?
  paymentMethod           String? // card|gcash|maya|bank_transfer|stripe (denorm for quick display)
  paidAt                  DateTime?
  failureReason           String?
  metadata                Json?
  // -- Stripe --------------------------------------------------------
  stripePaymentIntentId   String?   @unique // pi_xxx
  stripeCheckoutSessionId String? // cs_xxx � checkout origin
  stripeInvoiceId         String? // in_xxx � for subscription invoices
  stripeEventId           String? // evt_xxx � webhook event that created this record (idempotency)
  refundedAmount          Float? // partial refund tracking
  refundedAt              DateTime?
  stripeRefundId          String?   @unique // re_xxx
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now()) @updatedAt

  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  invoice     Invoice        @relation(fields: [invoiceId], references: [id])
  savedMethod PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([invoiceId])
  @@index([paymongoPaymentId])
  @@index([stripePaymentIntentId])
  @@index([stripeEventId])
}

// -----------------------------------------------------
// AUDIT LOG
// Mentor: "Audit Log is needed, logs of all actions with categorization"
// severity: INFO | WARNING | CRITICAL
// category: auth | crm | billing | workflow | admin | system
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model AuditLog {
  id         String   @id @default(uuid())
  tenantId   String
  userId     String
  action     String // e.g. "contact.created" | "deal.stage_changed" | "user.login"
  entityType String // e.g. "Contact" | "Deal" | "User"
  entityId   String?
  category   String   @default("crm") // auth|crm|billing|workflow|admin|system
  changeset  Json? // { before: { status: "WARM" }, after: { status: "HOT" } }
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  sessionId  String?
  severity   String   @default("INFO") // INFO|WARNING|CRITICAL
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, userId])
  @@index([tenantId, category])
  @@index([tenantId, severity])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// EMAIL DELIVERY LOG
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model EmailDeliveryLog {
  id             String    @id @default(uuid())
  tenantId       String
  campaignId     String?
  leadId         String?
  customerId     String?
  fromEmail      String
  toEmail        String
  subject        String
  gmailMessageId String?   @unique
  gmailThreadId  String?
  status         String // sent|delivered|opened|clicked|bounced|failed
  sentAt         DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  bouncedAt      DateTime?
  errorMessage   String?
  createdAt      DateTime  @default(now())

  tenant     Tenant       @relation(fields: [tenantId], references: [id])
  campaign   Campaign?    @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead       Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact    Contact?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  EmailEvent EmailEvent[]

  @@index([tenantId, leadId])
  @@index([tenantId, customerId])
  @@index([tenantId, campaignId])
  @@index([gmailMessageId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// VERIFICATION TOKEN (Email Verification)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model VerificationToken {
  id         String   @id @default(uuid())
  identifier String
  token      String   @unique
  expires    DateTime
  createdAt  DateTime @default(now())

  @@unique([identifier, token])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// PASSWORD RESET TOKEN
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@unique([email, token])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// REGISTRATION OTP TOKEN (email verification during registration)
model RegistrationOtpToken {
  id        String   @id @default(uuid())
  email     String
  codeHash  String
  expires   DateTime
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([email])
}

// ═══════════════════════════════════════════════════════════════════════
// EMAIL VERIFICATION TOKEN (magic link verification — separate from OTP)
// Stores SHA-256 hash of the plaintext token. Single-use, time-limited.
// ═══════════════════════════════════════════════════════════════════════
model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String?   // nullable — may be generated before user exists (e.g. pre-registration)
  email     String
  tokenHash String    @unique // SHA-256 hex digest of plaintext token
  type      String    @default("EMAIL_VERIFICATION") // "EMAIL_VERIFICATION" | "INVITATION"
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([userId])
}

// EMAIL ACCOUNT (Gmail OAuth2 integration per user)
// Stores encrypted tokens for Gmail API access.
// Each user can connect ONE Gmail account per tenant.
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model EmailAccount {
  id             String    @id @default(uuid())
  tenantId       String
  userId         String
  provider       String    @default("gmail") // "gmail" | future: "outlook"
  email          String // the connected Gmail address
  accessToken    String // encrypted G�� never log or expose
  refreshToken   String? // encrypted G�� needed for offline access
  tokenExpiresAt DateTime?
  scopes         String[] // granted OAuth scopes
  isActive               Boolean  @default(true)
  // -- Payment methods (per-plan config, stored as JSON) ------------
  paymentMethods         Json     @default("[]")
  lastSyncAt     DateTime?
  syncCursor     String? // Gmail history ID for incremental sync
  connectedAt    DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([tenantId, userId, provider])
  @@index([tenantId, userId])
  @@index([tenantId, isActive])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// SMS QUEUE (Local Android Gateway)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model SMSQueue {
  id           String    @id @default(uuid())
  tenantId     String
  campaignId   String?
  leadId       String?
  customerId   String?
  toNumber     String
  message      String
  status       String    @default("pending") // pending|processing|sent|delivered|failed
  retryCount   Int       @default(0)
  scheduledFor DateTime?
  sentAt       DateTime?
  errorMessage String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  campaign Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  contact  Contact?  @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([tenantId, scheduledFor])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// EMAIL EVENT (Tracking opens, clicks, etc.)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model EmailEvent {
  id            String   @id @default(uuid())
  tenantId      String
  deliveryLogId String
  eventType     String // open|click|bounce|unsubscribe
  url           String? // for clicks
  userAgent     String?
  ipAddress     String?
  createdAt     DateTime @default(now())

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  deliveryLog EmailDeliveryLog @relation(fields: [deliveryLogId], references: [id], onDelete: Cascade)

  @@index([tenantId, eventType])
  @@index([deliveryLogId])
}

// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
// AUTOMATION RULE (Trigger-based background jobs)
// G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��G��
model AutomationRule {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  triggerType String // e.g. "contact.created", "deal.won", "no.reply.3days"
  conditions  Json?
  actions     Json // what to do (e.g., schedule campaign)
  isActive               Boolean  @default(true)
  // -- Payment methods (per-plan config, stored as JSON) ------------
  paymentMethods         Json     @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, isActive])
  @@index([tenantId, triggerType])
}

// -----------------------------------------------------
// USER PREFERENCE (per-user, per-module, per-key)
// Generic preference storage for column configs, filters, sorts, etc.
// -----------------------------------------------------
model UserPreference {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  module    String   @db.VarChar(64)
  key       String   @db.VarChar(128)
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, module, key])
  @@index([tenantId, module])
}

// -----------------------------------------------------
// TENANT PREFERENCE (per-tenant, per-module, per-key)
// Tenant-level defaults managed by Client Admins.
// -----------------------------------------------------
model TenantPreference {
  id        String   @id @default(uuid())
  tenantId  String
  module    String   @db.VarChar(64)
  key       String   @db.VarChar(128)
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, module, key])
  @@index([tenantId, module])
}

// -----------------------------------------------------
// LEAD IMPORT (CSV batch import tracking)
// -----------------------------------------------------
model LeadImport {
  id                String    @id @default(uuid())
  tenantId          String
  fileName          String
  totalRecords      Int       @default(0)
  successfulRecords Int       @default(0)
  failedRecords     Int       @default(0)
  status            String    @default("pending") // pending|importing|completed|completed_with_errors|failed
  createdById       String
  createdAt         DateTime  @default(now())
  completedAt       DateTime?

  tenant    Tenant             @relation(fields: [tenantId], references: [id])
  createdBy User               @relation(fields: [createdById], references: [id])
  results   LeadImportResult[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

// -----------------------------------------------------
// LEAD IMPORT RESULT (per-row outcome)
// -----------------------------------------------------
model LeadImportResult {
  id          String   @id @default(uuid())
  importId    String
  rowNumber   Int
  status      String // imported|failed
  leadId      String? // set on success
  remarks     String? // error messages on failure
  firstName   String?
  lastName    String?
  email       String?
  phone       String?
  companyName String?
  address     String?
  createdAt   DateTime @default(now())

  import LeadImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@index([importId, status])
  @@index([importId, rowNumber])
}

